// Prisma Schema for SIH 2026 Problem Statement 44: bridgeNext ai / Skill Store
// Real Multi-Role Authentication, Onboarding & Competency Ecosystem

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  authUserId    String?   @unique
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  role          String    @default("STUDENT") // STUDENT, INDUSTRY, FACULTY, INSTITUTION, ADMIN
  avatarUrl     String?
  isOnboarded   Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile     StudentProfile?
  industryProfile    IndustryProfile?
  facultyProfile     FacultyProfile?
  institutionProfile InstitutionProfile?
  resetTokens        PasswordResetToken[]
  assessmentAttempts AssessmentAttempt[]
}

model StudentProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeName        String   @default("National Institute of Technology")
  university         String?  @default("National University")
  degree             String   @default("B.Tech")
  department         String   @default("Computer Science & Engineering")
  currentYear        Int?     @default(3)
  currentSemester    Int?     @default(6)
  graduationYear     Int      @default(2026)
  cgpa               Float?   @default(8.5)
  rollNo             String?
  bio                String?
  targetJobRole      String?  @default("Full-Stack AI Solutions Architect")
  targetCareersJson  String?  @default("[\"Software Developer\",\"Full Stack Developer\"]")
  preferredLocation  String?  @default("Bengaluru / Remote")
  preferredIndustry  String?  @default("AI & Cloud Software")
  softSkills         String?  @default("Problem Solving, Team Leadership, Fast Learner")
  certifications     String?
  experienceSummary  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  skills               StudentSkill[]
  programmingLanguages StudentProgrammingLanguage[]
  projects             PortfolioProject[]
  roadmaps             LearningRoadmap[]
  applications         JobApplication[]
  bookings             MentorshipBooking[]
}

model IndustryProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String   @default("TechCorp Global")
  companyWebsite     String   @default("https://techcorp.example.com")
  designation        String?  @default("Talent Acquisition Lead")
  domain             String?  @default("Software & Cloud Engineering")
  companyDescription String?  @default("Next-generation enterprise software, cloud infrastructure, and AI systems.")
  companySize        String?  @default("500-1000 employees")
  location           String?  @default("Bengaluru / Hybrid")
  hiringAreas        String?  @default("Full-Stack, Cloud DevOps, AI/ML")
  skillsRequired     String?  @default("React.js, Python, PostgreSQL, Docker")
  isVerified         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  jobPostings        JobPosting[]
}

model FacultyProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionName    String   @default("National Institute of Technology")
  department         String   @default("Computer Science & Engineering")
  designation        String   @default("Associate Professor")
  qualifications     String?  @default("Ph.D. in Computer Science")
  specialization     String?  @default("Distributed Systems & Cloud Computing")
  researchInterests  String?  @default("Distributed AI, Vector Databases, NEP 2020 OBE")
  mentorshipAreas    String?  @default("Full-Stack Architecture, Career Guidance, Capstone Projects")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  mentorshipSlots    MentorshipSlot[]
  endorsements       FacultyEndorsement[]
}

model InstitutionProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tpoName                String?  @default("Prof. S. Meenakshi")
  tpoDesignation         String?  @default("Head of Training & Placement")
  institutionName        String   @default("National Institute of Technology")
  institutionType        String   @default("Tier-1 Institute (IIT/NIT/IIIT)")
  universityAffiliation  String?  @default("Central University Board")
  officialEmail          String?
  website                String?  @default("https://nit.ac.in")
  city                   String?  @default("Tiruchirappalli")
  state                  String?  @default("Tamil Nadu")
  address                String?  @default("Tanjore Main Road, National Highway 67")
  departmentsList        String?  @default("CSE, IT, AI & Data Science, ECE, EEE, Mechanical")
  studentPopulation      Int?     @default(4500)
  code                   String?  @default("NIT-01")
  nirfRank               Int?     @default(9)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// SKILL TAXONOMY, ASSESSMENTS & OBE
// ----------------------------------------------------

model Skill {
  id                 String   @id @default(cuid())
  name               String   @unique
  category           String   // Languages, Frameworks, Databases, Cloud & DevOps, AI / ML, Core Engineering
  description        String?
  industryBenchmark  Float    @default(80.0) // 0 - 100 percentage benchmark
  icon               String?

  studentSkills      StudentSkill[]
  assessments        Assessment[]
}

model StudentSkill {
  id                 String    @id @default(cuid())
  studentProfileId   String
  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skillId            String
  skill              Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  selfScore          Float     @default(60.0)
  verifiedScore      Float?
  verificationStatus String    @default("SELF_REPORTED") // SELF_REPORTED, ASSESSMENT_VERIFIED, FACULTY_ENDORSED
  badgeEarned        String?
  verifiedAt         DateTime?
  updatedAt          DateTime  @updatedAt

  endorsements       FacultyEndorsement[]

  @@unique([studentProfileId, skillId])
}

model StudentProgrammingLanguage {
  id                 String         @id @default(cuid())
  studentProfileId   String
  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  language           String         // e.g. C, C++, Java, Python, JavaScript, TypeScript, Go, Rust, Kotlin, Swift, PHP, Ruby, Dart, C#
  proficiency        String         @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  verificationStatus String         @default("SELF_REPORTED") // SELF_REPORTED, FACULTY_ENDORSED, ASSESSMENT_VERIFIED
  verifiedScore      Float?
  relatedProjects    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([studentProfileId, language])
}

model Assessment {
  id              String   @id @default(cuid())
  skillId         String
  skill           Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  difficulty      String   @default("Intermediate") // Beginner, Intermediate, Advanced
  durationMinutes Int      @default(15)
  totalQuestions  Int      @default(5)
  passingScore    Float    @default(70.0) // Passing percentage threshold
  badgeReward     String   // e.g. "React Certified Developer"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions       AssessmentQuestion[]
  attempts        AssessmentAttempt[]
}

model AssessmentQuestion {
  id                 String     @id @default(cuid())
  assessmentId       String
  assessment         Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionText       String
  optionsJson        String     // JSON array of strings
  correctOptionIndex Int        // 0-indexed correct option
  explanation        String?
}

model AssessmentAttempt {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId     String
  assessment       Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  score            Float
  isPassed         Boolean
  answersJson      String     // JSON array of selected indices
  timeSpentSeconds Int        @default(0)
  completedAt      DateTime   @default(now())
}

model PortfolioProject {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String
  techStack        String         // Comma-separated or JSON string
  repoUrl          String?
  liveUrl          String?
  isVerified       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ----------------------------------------------------
// AI SKILL-GAP & LEARNING ROADMAPS
// ----------------------------------------------------

model TargetRole {
  id                  String            @id @default(cuid())
  title               String            @unique
  slug                String            @unique
  category            String            // Software & AI, Cloud & DevOps, Data & ML, Systems & Security
  description         String
  avgSalaryRange      String            @default("₹18 - ₹32 LPA")
  industryDemandLevel String            @default("HIGH") // HIGH, VERY HIGH, CRITICAL
  icon                String?           @default("Sparkles")
  requiredSkillsJson  String            // JSON Array of required skills
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  roadmaps            LearningRoadmap[]
}

model LearningRoadmap {
  id               String             @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  targetRoleId     String?
  targetRole       TargetRole?        @relation(fields: [targetRoleId], references: [id], onDelete: SetNull)
  roleTitle        String
  roleCategory     String?
  overallFitScore  Float              @default(0.0) // 0 - 100 percentage
  cosineSimilarity Float              @default(0.0) // 0 - 1.0
  gapSummary       String?
  estimatedWeeks   Int                @default(8)
  estimatedHours   Int                @default(40)
  progressPercent  Float              @default(0.0)
  status           String             @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  milestones       RoadmapMilestone[]

  @@unique([studentProfileId, roleTitle])
}

model RoadmapMilestone {
  id             String          @id @default(cuid())
  roadmapId      String
  roadmap        LearningRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  stepNumber     Int
  title          String
  description    String
  skillName      String
  gapDelta       Float           @default(0.0)
  resourceType   String          @default("VIDEO") // VIDEO, PROJECT, ARTICLE, DOCS, CERTIFICATION, LAB, COURSE
  resourceUrl    String
  provider       String?         @default("Coursera")
  estimatedHours Int             @default(6)
  isCompleted    Boolean         @default(false)
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ----------------------------------------------------
// RECRUITER ATS & JOB DRIVES
// ----------------------------------------------------

model JobPosting {
  id                 String           @id @default(cuid())
  industryProfileId  String
  industryProfile    IndustryProfile  @relation(fields: [industryProfileId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  jobType            String           @default("INTERNSHIP") // INTERNSHIP, FULL_TIME, APPRENTICESHIP
  location           String           @default("Bengaluru / Hybrid")
  stipendSalary      String           @default("₹60,000/mo")
  minCgpa            Float            @default(7.5)
  deadline           DateTime?
  status             String           @default("OPEN") // OPEN, CLOSED, FILLED
  requiredSkillsJson String           // JSON Array of required skills
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  applications       JobApplication[]
}

model JobApplication {
  id               String         @id @default(cuid())
  jobPostingId     String
  jobPosting       JobPosting     @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  status           String         @default("APPLIED") // APPLIED, UNDER_REVIEW, SHORTLISTED, TECHNICAL_INTERVIEW, OFFERED, REJECTED
  vectorMatchScore Float          @default(85.0) // 0 - 100%
  matchScore       Float          @default(85.0)
  notes            String?
  appliedAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([jobPostingId, studentProfileId])
}

// ----------------------------------------------------
// FACULTY MENTORSHIP & ACCREDITATION
// ----------------------------------------------------

model MentorshipSlot {
  id               String              @id @default(cuid())
  facultyProfileId String
  facultyProfile   FacultyProfile      @relation(fields: [facultyProfileId], references: [id], onDelete: Cascade)
  title            String              @default("1:1 Industry Alignment & Capstone Guidance")
  topic            String              @default("AI Systems Architecture & Skill Gap Review")
  scheduledAt      DateTime
  durationMinutes  Int                 @default(30)
  meetingUrl       String              @default("https://meet.google.com/bridgenext-guidance")
  status           String              @default("AVAILABLE") // AVAILABLE, BOOKED, COMPLETED, CANCELLED
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  bookings         MentorshipBooking[]
}

model MentorshipBooking {
  id               String         @id @default(cuid())
  slotId           String
  slot             MentorshipSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  notes            String?
  status           String         @default("CONFIRMED") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([slotId, studentProfileId])
}

model FacultyEndorsement {
  id               String         @id @default(cuid())
  facultyProfileId String
  facultyProfile   FacultyProfile @relation(fields: [facultyProfileId], references: [id], onDelete: Cascade)
  studentSkillId   String
  studentSkill     StudentSkill   @relation(fields: [studentSkillId], references: [id], onDelete: Cascade)
  endorsedScore    Float          @default(85.0)
  feedback         String?
  createdAt        DateTime       @default(now())
}
